# Netlify header rules. See https://docs.netlify.com/routing/headers/

# HTML pages are generated at build time with a fixed URL per route (e.g.
# /providers/index.html), so their content can change between deploys while
# the URL stays the same. Force browsers to always revalidate them with the
# origin instead of serving a stale copy from disk cache.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Vite fingerprints build assets with a content hash (e.g.
# /assets/index-4f3a2b1c.js), so a changed file always gets a new URL. Those
# are safe to cache aggressively and forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
